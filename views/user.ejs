<table border="1" cellpadding="10" cellspacing="0">
    <thead>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        <% for(let user of data) { %>
            <tr>
                <td><%= user.id %></td>
                <td><%= user.username %></td>
                <td><%= user.email %></td>

                <td>
                    <a href="/user/<%= user.id %>/edit">
                        <button>Edit</button>
                    </a>
                </td>
            </tr>
        <% } %>
    </tbody>
</table>