<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>
</head>
<body>

    <h1>Edit User</h1>

    <form action="/user/<%= user.id %>" method="POST">

        <label>Username:</label>
        <input
            type="text"
            name="username"
            value="<%= user.username %>"
        >

        <br><br>

        <label>Email:</label>
        <input
            type="email"
            name="email"
            value="<%= user.email %>"
        >

        <br><br>

        <button type="submit">Update User</button>

    </form>

</body>
</html>